# Serveur Ollama (local ou conteneur docker)
OLLAMA_BASE_URL=http://localhost:11434
# LLM multilingue (bon en arabe) — alternative légère : llama3.2:3b
SANAD_LLM=qwen2.5:7b
# Embeddings multilingues (FR/AR) — 1024 dimensions
SANAD_EMBED=bge-m3
SANAD_TEMPERATURE=0.1
SANAD_TOP_K=6
SANAD_MAX_REWRITES=2
SANAD_INDEX_DIR=index
SANAD_DOCS_DIR=data/docs
